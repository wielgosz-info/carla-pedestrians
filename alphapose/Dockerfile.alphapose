FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME='/usr/local/cuda'
ENV TORCH_CUDA_ARCH_LIST="7.5"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget git build-essential ninja-build \
    python3-pip python3-dev \
    libyaml-dev libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --upgrade pip && \
    pip3 install \
    numpy==1.23.5 \
    cython==0.29.36 \
    scipy \
    opencv-contrib-python-headless \
    opencv-python \
    pycocotools \
    tqdm \
    visdom \
    timm==0.1.20 \
    terminaltables \
    tensorboardX \
    easydict \
    pyyaml \
    munkres \
    natsort \
    pandas

# Install PyTorch
RUN pip3 install torch==2.0.1 torchvision==0.15.2 --index-url https://download.pytorch.org/whl/cu118

# Install cython_bbox
RUN pip3 install git+https://github.com/H4dr1en/cython_bbox.git@patch-1

# Clone projects
WORKDIR /workspace
RUN git clone https://github.com/HaoyiZhu/HalpeCOCOAPI.git && \
    git clone https://github.com/MVIG-SJTU/AlphaPose.git

# Build HalpeCOCOAPI
RUN cd /workspace/HalpeCOCOAPI/PythonAPI && \
    python3 setup.py build develop

# Build AlphaPose
RUN cd /workspace/AlphaPose && \
    python3 setup.py build develop --no-deps

# Create model directories (we'll download models at runtime)
RUN cd /workspace/AlphaPose && \
    mkdir -p detector/yolo/data pretrained_models

# Create user
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} alphapose-user && \
    useradd -ms /bin/bash -u ${USER_ID} -g ${GROUP_ID} alphapose-user && \
    chown -R alphapose-user:alphapose-user /workspace

WORKDIR /app
USER alphapose-user
ENV ALPHAPOSE_ROOT=/workspace/AlphaPose
ENV PYTHONPATH=/workspace/AlphaPose

CMD ["tail", "-f", "/dev/null"]